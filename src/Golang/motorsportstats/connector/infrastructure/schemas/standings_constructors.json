{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "properties": {
    "standings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "standings"
  ],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "constructor": {
          "$ref": "#/$defs/constructor"
        },
        "team": {
          "$ref": "#/$defs/team"
        },
        "countryRepresenting": {
          "$ref": "#/$defs/country"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "type": "number"
        },
        "analytics": {
          "$ref": "#/$defs/analytics"
        }
      },
      "required": [
        "constructor",
        "team",
        "countryRepresenting",
        "position",
        "points",
        "analytics"
      ],
      "additionalProperties": false
    },
    "constructor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "picture": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      },
      "required": [
        "name",
        "uuid",
        "picture"
      ],
      "additionalProperties": false
    },
    "team": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "colour": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "picture": {
          "type": "string",
          "format": "uri"
        },
        "carIcon": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "uuid",
        "colour",
        "picture",
        "carIcon"
      ],
      "additionalProperties": false
    },
    "country": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "picture": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "uuid",
        "picture"
      ],
      "additionalProperties": false
    },
    "analytics": {
      "type": "object",
      "properties": {
        "wins": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "wins"
      ],
      "additionalProperties": false
    }
  }
}
