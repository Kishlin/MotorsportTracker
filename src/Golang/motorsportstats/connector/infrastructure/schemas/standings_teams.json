{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "type": "object",
  "properties": {
    "standings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "standings"
  ],
  "additionalProperties": false,
  "$defs": {
    "entry": {
      "type": "object",
      "properties": {
        "team": {
          "$ref": "#/$defs/team"
        },
        "countryRepresenting": {
          "$ref": "#/$defs/country"
        },
        "icon": {
          "type": "string",
          "format": "uri"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "points": {
          "type": "number"
        },
        "analytics": {
          "$ref": "#/$defs/analytics"
        }
      },
      "required": [
        "team",
        "countryRepresenting",
        "icon",
        "position",
        "points",
        "analytics"
      ],
      "additionalProperties": false
    },
    "team": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "colour": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "picture": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "carIcon": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "uuid",
        "colour",
        "picture",
        "carIcon"
      ],
      "additionalProperties": false
    },
    "country": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "uuid": {
          "type": "string",
          "minLength": 1
        },
        "picture": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "name",
        "uuid",
        "picture"
      ],
      "additionalProperties": false
    },
    "analytics": {
      "type": "object",
      "properties": {
        "classWins": {
          "type": "integer",
          "minimum": 0
        },
        "fastestLaps": {
          "type": "integer",
          "minimum": 0
        },
        "finalAppearances": {
          "type": "integer",
          "minimum": 0
        },
        "finishes1And2": {
          "type": "integer",
          "minimum": 0
        },
        "podiums": {
          "type": "integer",
          "minimum": 0
        },
        "poles": {
          "type": "integer",
          "minimum": 0
        },
        "qualifies1And2": {
          "type": "integer",
          "minimum": 0
        },
        "racesLed": {
          "type": "integer",
          "minimum": 0
        },
        "ralliesLed": {
          "type": "integer",
          "minimum": 0
        },
        "retirements": {
          "type": "integer",
          "minimum": 0
        },
        "semiFinalAppearances": {
          "type": "integer",
          "minimum": 0
        },
        "stageWins": {
          "type": "integer",
          "minimum": 0
        },
        "starts": {
          "type": "integer",
          "minimum": 0
        },
        "top10s": {
          "type": "integer",
          "minimum": 0
        },
        "top5s": {
          "type": "integer",
          "minimum": 0
        },
        "wins": {
          "type": "integer",
          "minimum": 0
        },
        "winsPercentage": {
          "type": "number"
        }
      },
      "required": [
        "classWins",
        "fastestLaps",
        "finalAppearances",
        "finishes1And2",
        "podiums",
        "poles",
        "qualifies1And2",
        "racesLed",
        "ralliesLed",
        "retirements",
        "semiFinalAppearances",
        "stageWins",
        "starts",
        "top10s",
        "top5s",
        "wins",
        "winsPercentage"
      ],
      "additionalProperties": false
    }
  }
}
