{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(chmod:*)",
      "Bash(jq:*)",
      "Bash(docker compose:*)",
      "Bash(make:*)",
      "Bash(gofmt:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(./scripts/test-runner.sh:*)",
      "Bash(./scripts/architecture-check.sh:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in *.go) PATH=\"$PATH:/usr/local/go/bin\" gofmt -w \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "gofmt"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in */domain/*.go) out=$(bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/architecture-check.sh\" 2>&1) || { printf '%s\\n' \"$out\" | grep -E '^(FAIL|src/)' >&2; exit 2; };; esac; }",
            "timeout": 15,
            "statusMessage": "hexagonal boundary check"
          }
        ]
      }
    ]
  }
}
